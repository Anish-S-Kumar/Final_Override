# ==============================================================================
# FINAL OVERRIDE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in required secrets. Never commit .env to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
DB_PROVIDER=supabase

# ------------------------------------------------------------------------------
# SUPABASE DATABASE INTEGRATION (Canonical variables)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=

# Supabase secret service key (starts with sb_secret_ or service_role JWT)
# Used server-side ONLY. Never expose to client or browser.
# Alias accepted: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# Optional PostgreSQL Direct / Session Pooler URL for migration script (npm run db:migrate)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# REQUIRED SECURITY SECRETS
# ------------------------------------------------------------------------------
# Master Organizer Admin PIN (Required: min 8 characters; default 'INVICTORS' rejected)
ADMIN_PIN=

# Event Cryptographic Salt (Required: min 16 characters; fallback default rejected)
EVENT_SALT=

# Cryptographic secret for Stage 5 multi-device HMAC shards (Required: no default)
SHARD_SECRET=

# Coordinators & PINs: Comma-separated list with matching counts (min 6 chars per PIN)
COORDINATORS=
COORDINATOR_PINS=

# ------------------------------------------------------------------------------
# GAMEPLAY RULES & TIMERS
# ------------------------------------------------------------------------------
TIME_CAP_MINUTES=90
TIME_CAP_ENFORCED=true
TAB_PENALTY_MINUTES=1
TAB_PENALTY_ENABLED=true
MIN_TEAM_SIZE=3
MAX_TEAM_SIZE=4
ALLOW_NEW_TEAMS=false

# ------------------------------------------------------------------------------
# WARDEN AI PROTOCOL
# ------------------------------------------------------------------------------
# Mode: 'rules' (default, deterministic rule engine) or 'llm' (OpenAI / Anthropic)
WARDEN_MODE=rules
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
